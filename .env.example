# ===================================================================
#  ФАЙЛ НАСТРОЕК. Скопируйте его в файл с именем .env и заполните.
#  Никому не показывайте .env и не загружайте его на GitHub.
# ===================================================================

# --- Telegram ---
# Токен бота из @BotFather (выглядит как 1234567890:AAH...)
BOT_TOKEN=

# Прокси для связи с Telegram. Нужен, только если сервер в России и бот пишет
# «Request timeout error». Формат: socks5://логин:пароль@адрес:порт или http://...
TELEGRAM_PROXY=

# ID приватного канала (начинается с -100). Если не знаете, оставьте пустым,
# запустите бота и перешлите ему любой пост из канала: он пришлёт ID.
CHANNEL_ID=

# Ваш Telegram-ID (узнать: напишите боту /id). Сюда приходят уведомления о продажах.
# Несколько админов можно указать через запятую.
ADMIN_IDS=

# --- Продукт ---
PRODUCT_NAME=Гайд «Не баночки, а логика: как выбирать уход за волосами по составу»
PRICE=490

# --- ЮKassa (личный кабинет → Интеграция → Ключи API) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Чеки по 54-ФЗ.
#   true  — у вас ИП/ООО и подключены «Чеки от ЮKassa» или онлайн-касса (бот спросит email для чека)
#   false — вы самозанятая: ЮKassa сама отправит чек в «Мой налог», email спрашивать не нужно
RECEIPT_ENABLED=true
# Ставка НДС для чека: 1 — без НДС. Если не уверены, уточните у бухгалтера.
VAT_CODE=1

# --- Сервер (обычно менять не нужно) ---
# Ваш домен для приёма уведомлений ЮKassa. Нет домена — впишите IP сервера
# через дефисы и .sslip.io, например: 85-193-80-12.sslip.io
DOMAIN=
WEBHOOK_PORT=8080
WEBHOOK_PATH=/yookassa/webhook
DB_PATH=data/shop.db
# Как часто (в секундах) бот сам перепроверяет неоплаченные заказы в ЮKassa
CHECK_INTERVAL_SEC=30
# Через сколько минут напомнить тому, кто начал покупку, но не оплатил (0 — не напоминать)
REMINDER_MINUTES=60
